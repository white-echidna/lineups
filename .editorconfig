# EditorConfig is awesome: https://editorconfig.org

# top-most EditorConfig file
root = true

[*]
# Set default charset
charset = utf-8

# Unix-style newlines with a newline ending every file
end_of_line = lf
insert_final_newline = true

# JSON files
[*.json]
indent_size = 2

# YAML files
[*.{yml, yaml}]
indent_size = 2

# TOML files
[*.toml]
indent_size = 2

# Markdown files
[*.md]
indent_size = 2
trim_trailing_whitespace = false

# Jinja2 files
[*.j2]
indent_size = 2

# Python files
[*.py]
indent_size = 4

# Shell-script files
[*.sh]
indent_size = 2

# Nix files
[*.nix]
indent_size = 2
